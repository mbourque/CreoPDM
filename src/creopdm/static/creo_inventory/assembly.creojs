function appendCrossSectionStructureRows(flat, treeChildren, solid) {
  var xsecs = listModelCrossSections(solid);
  if (!xsecs.length) return;
  flat.push({
    name: "Model cross-sections",
    id: null,
    type: "GROUP",
    level: 1,
    status: "ACTIVE",
    suppressed: false,
    path: "xsec:root",
    subType: "CROSS_SECTION"
