  return node;
}

/**
 * Flattened structure rows + nested tree.
 * Groups nest recursively (workcell → op → sequences); members indent under parents.
 */
function walkAssemblyStructure(model, session, level, maxDepth, pathPrefix, visited, flat, treeChildren) {
  if (level > maxDepth) return;
  var solid = resolveStructureSolid(model, session);
  var mfgRoot = false;
  try {
    mfgRoot =
