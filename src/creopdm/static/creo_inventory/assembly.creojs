  if (!name && id == null) return null;
  var path = pathPrefix ? pathPrefix + "/" + String(id) : String(id == null ? "?" : id);
  var statusInfo = featureStatusInfo(feat);
  var row = {
    name: name || ("COMPONENT (" + id + ")"),
    id: id,
    type: type,
    level: level,
    status: statusInfo.status,
    suppressed: statusInfo.suppressed,
    path: path
  };
  flat.push(row);
  var node = {
    name: row.name,
    id: id,
    type: type,
