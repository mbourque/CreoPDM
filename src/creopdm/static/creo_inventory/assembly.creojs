    var xs = xsecs[i];
    var path = "xsec:root/xsec:" + xs.name;
    flat.push({
      name: xs.name,
      id: xs.id,
      type: "CROSS_SECTION",
      level: 2,
      status: "ACTIVE",
      suppressed: false,
      path: path,
      subType: xs.xsecType || "Cross Section"
