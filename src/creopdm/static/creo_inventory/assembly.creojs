function listAssemblyStructureForModel(model, session) {
  var fileName = "";
  try {
    fileName = String(model.FileName || "");
  } catch (e) {
    fileName = "";
  }
  fileName = logicalFileName(fileName) || fileName;

  if (!isAssemblyModel(model, fileName)) {
